{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khshab.valuation-bundle/v1",
  "title": "Teacher-guide-aligned content valuation bundle v1",
  "description": "Versioned audit records; an automated bundle cannot create human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "valuation_bundle_id", "source_binding", "extraction_bundle_sha256", "teacher_guide", "objectives", "records"],
  "properties": {
    "schema_version": {"const": "khshab.valuation-bundle/v1"},
    "valuation_bundle_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "source_binding": {"$ref": "extraction-ledger-v1.schema.json#/$defs/sourceBinding"},
    "extraction_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "teacher_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guide_id", "guide_sha256", "book_code", "grade", "subject_id"],
      "properties": {
        "guide_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "guide_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "book_code": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "grade": {"type": "integer", "minimum": 1, "maximum": 12},
        "subject_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}
      }
    },
    "objectives": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["objective_id", "level", "parent_objective_id"],
        "properties": {
          "objective_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "level": {"enum": ["GENERAL", "SPECIFIC", "BEHAVIORAL"]},
          "parent_objective_id": {"type": ["string", "null"]}
        }
      }
    },
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["valuation_id", "extraction_record_id", "element_id", "objective_ids", "concept_id", "role", "operation_id", "number_domain_id", "assessment_status", "confidence", "review_status", "human_verdict_id"],
        "properties": {
          "valuation_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "extraction_record_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "element_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "concept_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "role": {"enum": ["PRIMARY", "SUPPORTING", "INCIDENTAL"]},
          "operation_id": {"type": ["string", "null"]},
          "number_domain_id": {"type": ["string", "null"]},
          "prerequisite_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "assessment_status": {"enum": ["IN_SCOPE", "OUT_OF_SCOPE", "UNKNOWN"]},
          "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNOBSERVABLE"]},
          "review_status": {"enum": ["DRAFT", "REQUIRES_HUMAN", "HUMAN_APPROVED", "REJECTED"]},
          "human_verdict_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
