{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khshab.game-content-pack/v1",
  "title": "Traceable game and practice content pack v1",
  "description": "Draft game items must point to extraction and valuation records; this schema grants no release permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game_pack_id", "source_binding", "valuation_bundle_sha256", "items"],
  "properties": {
    "schema_version": {"const": "khshab.game-content-pack/v1"},
    "game_pack_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "source_binding": {"$ref": "extraction-ledger-v1.schema.json#/$defs/sourceBinding"},
    "valuation_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["game_item_id", "extraction_record_id", "element_id", "valuation_ids", "objective_ids", "activity_kind", "mechanic_id", "difficulty_id", "personalization_tags", "generation_status"],
        "properties": {
          "game_item_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "extraction_record_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "element_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "valuation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "objective_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "activity_kind": {"enum": ["PRACTICE", "GAME", "TEACHER_TOOL"]},
          "mechanic_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "difficulty_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "personalization_tags": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}, "uniqueItems": true},
          "generation_status": {"enum": ["DRAFT", "BLOCKED"]}
        }
      }
    }
  }
}
