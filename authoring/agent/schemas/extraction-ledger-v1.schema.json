{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khshab.extraction-ledger/v1",
  "title": "Page-level structured extraction ledger v1",
  "description": "Git-versionable structured observations. No PDF/image payloads or long verbatim text are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "source_binding", "offset_proof_sha256", "section_scope", "pages"],
  "properties": {
    "schema_version": {"const": "khshab.extraction-ledger/v1"},
    "bundle_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "source_binding": {"$ref": "#/$defs/sourceBinding"},
    "offset_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "section_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "pdf_page_start", "pdf_page_end", "book_page_start", "book_page_end"],
      "properties": {
        "section_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "pdf_page_start": {"type": "integer", "minimum": 1},
        "pdf_page_end": {"type": "integer", "minimum": 1},
        "book_page_start": {"type": "integer", "minimum": 1},
        "book_page_end": {"type": "integer", "minimum": 1}
      }
    },
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageRecord"}}
  },
  "$defs": {
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "book_code", "edition_id", "manifest_id", "manifest_sha256", "source_pdf_sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "book_code": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "edition_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "manifest_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "source_pdf_sha256", "pdf_page", "book_page", "bbox_normalized", "sha256"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "kind": {"enum": ["pdf_text_bbox", "pdf_crop_150dpi", "pdf_page_render"]},
        "purpose": {"enum": ["PRINTED_PAGE_NUMBER"]},
        "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pdf_page": {"type": "integer", "minimum": 1},
        "book_page": {"type": "integer", "minimum": 1},
        "bbox_normalized": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 4, "maxItems": 4},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "element_kind", "concept_candidate_ids", "operation_ids", "number_domain_ids", "evidence_refs"],
      "properties": {
        "element_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "element_kind": {"enum": ["TASK", "EXAMPLE", "DEFINITION", "RULE", "VISUAL", "INSTRUCTION", "OTHER"]},
        "concept_candidate_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}, "uniqueItems": true},
        "operation_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}, "uniqueItems": true},
        "number_domain_ids": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}, "uniqueItems": true},
        "short_excerpt": {"type": "string", "maxLength": 120},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "pageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "pdf_page", "book_page", "printed_page_number", "page_image_sha256", "page_status", "reading_status", "visual_scan_status", "evidence_refs", "elements"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "pdf_page": {"type": "integer", "minimum": 1},
        "book_page": {"type": "integer", "minimum": 1},
        "printed_page_number": {"type": "integer", "minimum": 1},
        "page_image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_status": {"enum": ["CURRICULAR_CONTENT", "NO_CURRICULAR_TASK", "BLOCKED"]},
        "reading_status": {"enum": ["COMPLETE", "INCOMPLETE", "UNOBSERVABLE"]},
        "visual_scan_status": {"enum": ["COMPLETE", "NOT_APPLICABLE", "INCOMPLETE", "UNOBSERVABLE"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}
      }
    }
  }
}
