{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khshab.offset-proof/v1",
  "title": "Source-bound printed-page offset proof v1",
  "description": "Two-pass printed-page observations tied to exact PDF pages and extraction evidence; reader independence is not cryptographically proven.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proof_id", "status", "source_binding", "section_id", "pdf_minus_book_offset", "expected_page_count", "matched_page_count", "reader_pass_sha256", "page_anchors"],
  "properties": {
    "schema_version": {"const": "khshab.offset-proof/v1"},
    "proof_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "status": {"enum": ["TWO_READER_MATCHED", "SYNTHETIC_TEST_ONLY"]},
    "source_binding": {"$ref": "extraction-ledger-v1.schema.json#/$defs/sourceBinding"},
    "section_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "pdf_minus_book_offset": {"type": "integer"},
    "expected_page_count": {"type": "integer", "minimum": 1},
    "matched_page_count": {"type": "integer", "minimum": 1},
    "reader_pass_sha256": {"type": "array", "prefixItems": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}], "items": false, "minItems": 2, "maxItems": 2, "uniqueItems": true},
    "page_anchors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pdf_page", "book_page", "printed_page_number", "evidence_id", "evidence_sha256"],
        "properties": {
          "pdf_page": {"type": "integer", "minimum": 1},
          "book_page": {"type": "integer", "minimum": 1},
          "printed_page_number": {"type": "integer", "minimum": 1},
          "evidence_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
          "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
