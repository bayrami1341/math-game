{
  "name": "math-game",
  "version": "8.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "description": "Math Workshop regression and v9 contract validation tools",
  "scripts": {
    "test": "node tests/run-mastery.js && node --test tests/*.test.js",
    "test:contracts": "node --test tests/v9-phase1-contracts.test.js",
    "test:v9": "node --test tests/v9-server.test.js tests/v9-local.test.js",
    "dev:v9": "node server/start.js --local",
    "start:v9": "node server/start.js"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "firebase-admin": "14.5.0"
  }
}
