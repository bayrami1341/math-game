  "owner": {
    "contract": "Z.ai (قرارداد نرم‌افزاری: مسیریاب، حدها، تست)",
    "scenario": "آرنا (سناریوی بازی و نیاز آموزشی)",
    "pedagogy": "معلم (حکم نهایی دامنه‌ها و کدهای تشخیصی)"
  },
  "purpose": "قرارداد نسخه‌دار عملیات برای موتور بازی: هر عملیات با نوع پاسخ، دامنهٔ per-book/per-grade، موتور تشخیص و بازخورد پیشنهادی — سازگار با کارتریج‌های فعلی (سؤال بدون op = ضرب میراثی با f1&f2، رفتار امروز دست‌نخورده)",
  "compatibility": {
    "backward": "کامل — فیلد op و opSpec «اختیاری و افزودنی» است؛ هر سه کارتریج رسمی (KH-G2/G3/DEMO) بدون هیچ تغییری بازی می‌شوند",
    "futureQuestions": "سؤال تازه می‌تواند op + opSpec (شیء مشخصات) + answerFormat بدهد؛ مسیریاب بر اساس op به موتور درست می‌رود"
  },
  "responseTypes": {
    "گزینه‌ای": {
      "payload": "index 0..3",
      "classification": "اطلس-لنگر (claims/optionErrorMap) — بدون طبقه‌بندی عددی"
    },
    "عدد": {
      "payload": "int",
      "classification": "موتور عملیات (attempt/v103/w8 بر اساس op)"
    },
    "کسر": {
      "payload": "«a/b» یا «a b/c» فارسی/لاتین",
      "classification": "classifyW8 با حساب گویای exact (BigInt)"
    },
    "محور عددی": {
      "payload": "عدد روی محور + tolerance از renderHint",
      "classification": "مقایسهٔ تلورانس؛ کد ساختاری W8 اگر op داشته باشد"
    },
    "زوج‌سازی": {
      "payload": "جفت‌های انتخابی",
      "classification": "بررسی جفت درست؛ کد ساختاری W8 اگر op داشته باشد"
    },
    "شکل/نمودار": {
      "payload": "subkind + مقدار",
      "classification": "بررسی subkind؛ کد ساختاری W8 اگر op داشته باشد"
    }
  },
