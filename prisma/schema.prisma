// داشبورد معلم — کارگاه ضرب (مضاعف)
// مدل داده برای پیشرفت دانش‌آموزان و تشخیص گلوگاه‌های یادگیری

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// دانش‌آموز کلاس
model Student {
  id        String   @id @default(cuid())
  name      String
  grade     Int // پایه تحصیلی (۴، ۵، ۶)
  hero      String   @default("astronaut") // astronaut | pilot | scientist
  createdAt DateTime @default(now())

  sessions Session[]
  results  QuestionResult[]
  assignments Assignment[]

  @@index([grade])
}

// مأموریت درمانی ارسالی معلم به دانش‌آموز (حلقهٔ گزارش ← اقدام ← اجرا در بازی)
model Assignment {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  missionId   String // side-1-antenna | side-2-backup | side-3-fuel
  fact        String? // فاکتور مبنای تشخیص (مثل «7×8»)
  note        String? // یادداشت معلم
  status      String    @default("pending") // pending | seen | completed
  sessionId   String? // جلسه‌ای که مأموریت را کامل کرد
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([studentId, status])
  @@index([status, createdAt])
}

// یک جلسه تمرین کامل‌شده در بازی
model Session {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  buildingId  String   @default("unknown") // station-power | station-antenna | station-launch ...
  layer       Int // لایه عمق ۱ تا ۹ (مدل ۹ لایه v10.1)
  mode        String   @default("station") // station | online | side
  total       Int
  correct     Int
  durationSec Int      @default(0)
  eventId     String?  @unique // شناسهٔ idempotency — ریترای شبکه رکورد تکراری نمی‌سازد
  createdAt   DateTime @default(now())

  results QuestionResult[]

  @@index([studentId, createdAt])
  @@index([createdAt])
}

// نتیجه تک‌تک سؤال‌ها — پایه تشخیص گلوگاه (a×b)
model QuestionResult {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String // denormalized برای پرس‌وجوی سریع گلوگاه هر دانش‌آموز
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  a         Int
  b         Int
  correct   Boolean
  timeSec   Float    @default(0)
  layer     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([a, b])
  @@index([studentId, createdAt])
  @@index([createdAt])
}
