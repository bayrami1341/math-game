{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayrami1341.github.io/math-game/contracts/v9-runtime-api.schema.json",
  "title": "V9 runtime preview extensions",
  "description": "9.0.2-runtime-preview. Additive HTTP contracts; phase-one five operation payloads remain unchanged.",
  "$defs": {
    "getIdentityRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "getClassRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "classId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "studentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "schemaVersion",
        "classId"
      ],
      "additionalProperties": false
    },
    "setMembershipRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "classId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "studentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "classId",
        "studentId",
        "status"
      ],
      "additionalProperties": false
    },
    "getSyncStatusRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "schemaVersion",
        "sessionId"
      ],
      "additionalProperties": false
    },
    "finalizeSessionRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "requestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "writerEpoch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schemaVersion",
        "requestId",
        "sessionId",
        "writerEpoch"
      ],
      "additionalProperties": false
    }
  }
}
